---
import { Image } from 'astro:assets';
import githubIcon from "../assets/github.svg"


interface Props {
    projectName: string;
    projectDescription: string;
    projectTech: string;
    githubLink?: string;
    websiteLink?: string;
    projectImage?: string;
}

const {projectName, projectDescription, projectTech, githubLink, websiteLink, projectImage} = Astro.props   
---
<div class="flex flex-col items-center justify-center gap-2 text-center px-8 font-semibold xl:px-0 xl:items-start xl:w-6/12">
    <a href={websiteLink}>
        <h1 class=" text-4xl mb-2 text-cyan-600  xl:text-5xl">{projectName}</h1> 
    </a>
    <p class="text-md xl:text-2xl xl:text-left">{projectDescription}</p>
    <p class="text-xs xl:text-lg">{projectTech}</p>
    <slot />
</div>